digraph fig_npu_top_simple {
  graph [rankdir=TB,bgcolor="white",pad=0.14,nodesep=0.45,ranksep=0.55,splines=polyline,dpi=180,fontname="Noto Sans CJK SC",label="npu_top 实例关系简图",labelloc=t,fontsize=30];
  node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=23,margin="0.18,0.12",penwidth=2.0,color="#455A64"];
  edge [fontname="Noto Sans CJK SC",fontsize=17,penwidth=2.0,arrowsize=0.85,color="#455A64"];

  regif [label="npu_axil_reg_if\n软件可见配置",fillcolor="#FFF8E1",color="#F9A825"];
  top [label="npu_top\n配置流水 + 任务控制",fillcolor="#EDE7F6",color="#5E35B1"];
  load [label="loaders\nIA / W / Bias / Quant",fillcolor="#E3F2FD",color="#1565C0"];
  compute [label="compute_core\n阵列 + ps_buffer",fillcolor="#FFEBEE",color="#C62828"];
  output [label="output path\nrequant / FIFO / writer",fillcolor="#FCE4EC",color="#AD1457"];
  dma [label="axi_block_dma_arbiter\n+ axi_dual_block_dma",fillcolor="#E0F7FA",color="#00838F"];
  axi [label="AXI4 主接口",fillcolor="#E0F2F1",color="#00695C"];

  { rank=same; load; compute; output; }
  { rank=same; dma; axi; }

  regif -> top [label="cfg + start"];
  top -> load [label="init / send"];
  load -> compute [label="IA / W / bias"];
  compute -> output [label="acc"];
  load -> dma [label="读请求",constraint=false];
  output -> dma [label="写请求"];
  dma -> axi [label="AR/R/AW/W/B"];
  top -> regif [style=dashed,color="#607D8B",constraint=false];
}
