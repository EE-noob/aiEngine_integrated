digraph fig_dma_arbiter_simple {
  graph [rankdir=TB,bgcolor="white",pad=0.14,nodesep=0.45,ranksep=0.55,splines=polyline,dpi=180,fontname="Noto Sans CJK SC",label="DMA 仲裁与 AXI 通道简图",labelloc=t,fontsize=30];
  node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=23,margin="0.18,0.12",penwidth=2.0,color="#455A64"];
  edge [fontname="Noto Sans CJK SC",fontsize=17,penwidth=2.0,arrowsize=0.85,color="#455A64"];

  reads [label="读客户端\nIA / Weight / Bias / Quant",fillcolor="#E3F2FD",color="#1565C0"];
  write [label="写客户端\nOA writer",fillcolor="#FCE4EC",color="#AD1457"];
  arb [label="axi_block_dma_arbiter\n选择客户端并保持 grant",fillcolor="#FFF8E1",color="#F9A825"];
  dma [label="axi_dual_block_dma\n二维地址、burst、非对齐",fillcolor="#E0F7FA",color="#00838F"];
  axi [label="AXI4\nAR/R 读通道\nAW/W/B 写通道",fillcolor="#EDE7F6",color="#5E35B1"];

  { rank=same; reads; write; }

  reads -> arb [label="rd_req"];
  write -> arb [label="wr_req"];
  arb -> dma [label="命令字段"];
  dma -> axi [label="burst"];
  axi -> dma [label="R 数据 / B 响应",style=dashed,color="#607D8B"];
  dma -> arb [style=dashed,color="#607D8B",constraint=false];
}
