# seed规则：行内 seed=N 固定；省略且未给全局seed则每次随机；下方预置seed描述仅指单例默认值。
# 每行一个回归 case，名称与 make target 相同；# 后为注释。
# 在 veri/sim 执行：make regr regrlist=文件名（可省略.list，也可传完整路径）。
# 本列表仅跑功能，不自动收集覆盖率；覆盖率请用 make coverage。
soc_runtime_ws_int8 # WS int8 基线，验证 CPU→驱动→NPU→共享RAM 完整路径；Python 生成 case/golden，CPU runtime 固件读 runtime_data.mem 配置 NPU，检查输出与 golden；UVM 检查 finish/status/trap/超时；固定 K/N/M=16/16/16，lhs=s8, rhs=s8，WS，per-tensor；矩阵固定顺序编码(s8 展平序号/s16 行列编码)，bias 用 NumPy [-10000,10000) 伪随机；默认 AXI 延迟不随机；预置 SV/Python seed=70000，regr_seed 可统一覆盖（固定激励不会因换种子变随机）
soc_reg_directed # CPU 执行 soc_reg_directed_main.c，验证 SoC 总线上的 NPU 寄存器读写，不以矩阵运算为主要判据；CPU 执行专用寄存器固件；固定 K/N/M=1/1/1，lhs=s8, rhs=s8，WS，per-tensor；矩阵固定顺序编码(s8 展平序号/s16 行列编码)，bias 用 NumPy [-10000,10000) 伪随机；默认 AXI 延迟不随机；预置 SV/Python seed=20260416，regr_seed 可统一覆盖（固定激励不会因换种子变随机）
soc_runtime_is_int16 # IS int16 输入基线，检查输入数据流切换和输出正确性；Python 生成 case/golden，CPU runtime 固件读 runtime_data.mem 配置 NPU，检查输出与 golden；UVM 检查 finish/status/trap/超时；固定 K/N/M=16/16/16，lhs=s16, rhs=s8，IS，per-tensor；矩阵固定顺序编码(s8 展平序号/s16 行列编码)，bias 用 NumPy [-10000,10000) 伪随机；默认 AXI 延迟不随机；预置 SV/Python seed=70001，regr_seed 可统一覆盖（固定激励不会因换种子变随机）
soc_runtime_per_channel_int8 # 验证 int8 per-channel 量化参数读取和逐通道结果；Python 生成 case/golden，CPU runtime 固件读 runtime_data.mem 配置 NPU，检查输出与 golden；UVM 检查 finish/status/trap/超时；固定 K/N/M=16/16/16，lhs=s8, rhs=s8，WS，per-channel；矩阵固定顺序编码(s8 展平序号/s16 行列编码)，bias 用 NumPy [-10000,10000) 伪随机；默认 AXI 延迟不随机；预置 SV/Python seed=71000，regr_seed 可统一覆盖（固定激励不会因换种子变随机）
soc_reuse_ws_int8 # 验证 WS 下 IA/weight reuse，检查缓存复用后结果不变；Python 生成 case/golden，CPU runtime 固件读 runtime_data.mem 配置 NPU，检查输出与 golden；UVM 检查 finish/status/trap/超时；固定 K/N/M=32/64/48，lhs=s8, rhs=s8，WS，per-tensor；矩阵固定顺序编码(s8 展平序号/s16 行列编码)，bias 用 NumPy [-10000,10000) 伪随机；配置 IA_REUSE_NUM=2, W_REUSE_NUM=4；默认 AXI 延迟不随机；预置 SV/Python seed=71500，regr_seed 可统一覆盖（固定激励不会因换种子变随机）
soc_reuse_is_int16 # 验证 IS 下 int16 输入的缓存复用；Python 生成 case/golden，CPU runtime 固件读 runtime_data.mem 配置 NPU，检查输出与 golden；UVM 检查 finish/status/trap/超时；固定 K/N/M=32/64/48，lhs=s16, rhs=s8，IS，per-tensor；矩阵固定顺序编码(s8 展平序号/s16 行列编码)，bias 用 NumPy [-10000,10000) 伪随机；配置 IA_REUSE_NUM=2, W_REUSE_NUM=4；默认 AXI 延迟不随机；预置 SV/Python seed=71501，regr_seed 可统一覆盖（固定激励不会因换种子变随机）
soc_reuse_wide_ws_int8 # 验证 WS 宽输出、多列 tile 与较大 reuse；Python 生成 case/golden，CPU runtime 固件读 runtime_data.mem 配置 NPU，检查输出与 golden；UVM 检查 finish/status/trap/超时；固定 K/N/M=64/64/64，lhs=s8, rhs=s8，WS，per-tensor；矩阵固定顺序编码(s8 展平序号/s16 行列编码)，bias 用 NumPy [-10000,10000) 伪随机；配置 IA_REUSE_NUM=8, W_REUSE_NUM=8；默认 AXI 延迟不随机；预置 SV/Python seed=71510，regr_seed 可统一覆盖（固定激励不会因换种子变随机）
soc_reuse_multigroup_ws_int8 # 验证 WS 输出跨多组 tile，检查分组步进与写回；Python 生成 case/golden，CPU runtime 固件读 runtime_data.mem 配置 NPU，检查输出与 golden；UVM 检查 finish/status/trap/超时；固定 K/N/M=16/16/128，lhs=s8, rhs=s8，WS，per-tensor；矩阵固定顺序编码(s8 展平序号/s16 行列编码)，bias 用 NumPy [-10000,10000) 伪随机；配置 IA_REUSE_NUM=1, W_REUSE_NUM=4；默认 AXI 延迟不随机；预置 SV/Python seed=71512，regr_seed 可统一覆盖（固定激励不会因换种子变随机）
soc_reuse_multigroup_deep_ws_int8 # 验证更深的多组输出与 PS/reuse 分组计数；Python 生成 case/golden，CPU runtime 固件读 runtime_data.mem 配置 NPU，检查输出与 golden；UVM 检查 finish/status/trap/超时；固定 K/N/M=16/16/256，lhs=s8, rhs=s8，WS，per-tensor；矩阵固定顺序编码(s8 展平序号/s16 行列编码)，bias 用 NumPy [-10000,10000) 伪随机；配置 IA_REUSE_NUM=1, W_REUSE_NUM=4；默认 AXI 延迟不随机；预置 SV/Python seed=71513，regr_seed 可统一覆盖（固定激励不会因换种子变随机）
soc_reuse_wide_is_int16 # 验证 IS 宽输出、int16 输入与多组 reuse；Python 生成 case/golden，CPU runtime 固件读 runtime_data.mem 配置 NPU，检查输出与 golden；UVM 检查 finish/status/trap/超时；固定 K/N/M=64/64/64，lhs=s16, rhs=s8，IS，per-channel；矩阵固定顺序编码(s8 展平序号/s16 行列编码)，bias 用 NumPy [-10000,10000) 伪随机；配置 IA_REUSE_NUM=8, W_REUSE_NUM=8；默认 AXI 延迟不随机；预置 SV/Python seed=71511，regr_seed 可统一覆盖（固定激励不会因换种子变随机）
soc_saturation_clamp_ws_int8 # 验证 WS 饱和/激活上下界裁剪；Python 生成 case/golden，CPU runtime 固件读 runtime_data.mem 配置 NPU，检查输出与 golden；UVM 检查 finish/status/trap/超时；固定 K/N/M=16/64/16，lhs=s8, rhs=s8，WS，per-tensor；NumPy 随机 lhs(s8 [-128,128)/s16 [-32768,32768))、rhs s8 [-128,128)、bias [-10000,10000)；配置 DST_MULT=1073741824, DST_SHIFT=0, ACT_MIN=-1, ACT_MAX=1；默认 AXI 延迟不随机；预置 SV/Python seed=71520，regr_seed 可统一覆盖（固定激励不会因换种子变随机）
soc_saturation_clamp_is_int8 # 验证 IS 饱和/激活上下界裁剪；Python 生成 case/golden，CPU runtime 固件读 runtime_data.mem 配置 NPU，检查输出与 golden；UVM 检查 finish/status/trap/超时；固定 K/N/M=16/64/16，lhs=s8, rhs=s8，IS，per-tensor；NumPy 随机 lhs(s8 [-128,128)/s16 [-32768,32768))、rhs s8 [-128,128)、bias [-10000,10000)；配置 DST_MULT=1073741824, DST_SHIFT=0, ACT_MIN=-1, ACT_MAX=1；默认 AXI 延迟不随机；预置 SV/Python seed=71521，regr_seed 可统一覆盖（固定激励不会因换种子变随机）
soc_per_channel_clamp_ws_int8 # 验证 per-channel 量化与激活裁剪组合；Python 生成 case/golden，CPU runtime 固件读 runtime_data.mem 配置 NPU，检查输出与 golden；UVM 检查 finish/status/trap/超时；固定 K/N/M=16/64/16，lhs=s8, rhs=s8，WS，per-channel；NumPy 随机 lhs(s8 [-128,128)/s16 [-32768,32768))、rhs s8 [-128,128)、bias [-10000,10000)；配置 DST_MULT=2147483647, DST_SHIFT=0, ACT_MIN=-1, ACT_MAX=1；默认 AXI 延迟不随机；预置 SV/Python seed=72000，regr_seed 可统一覆盖（固定激励不会因换种子变随机）
soc_requant_directed_clamp_ws_int8 # 正负双极定向激励，专门覆盖 requant 后上下界裁剪；Python 生成 case/golden，CPU runtime 固件读 runtime_data.mem 配置 NPU，检查输出与 golden；UVM 检查 finish/status/trap/超时；固定 K/N/M=16/64/16，lhs=s8, rhs=s8，WS，per-channel；lhs 偶数行7/奇数行-8，rhs=7，bias=0，不随机；配置 DIRECTED_PATTERN=requant_clamp_bipolar, DST_MULT=2147483647, DST_SHIFT=0, ACT_MIN=-1, ACT_MAX=1；默认 AXI 延迟不随机；预置 SV/Python seed=72030，regr_seed 可统一覆盖（固定激励不会因换种子变随机）
soc_tail_ws_int8 # 验证 WS 非整 tile 尺寸的尾部掩码和写回；Python 生成 case/golden，CPU runtime 固件读 runtime_data.mem 配置 NPU，检查输出与 golden；UVM 检查 finish/status/trap/超时；固定 K/N/M=17/31/19，lhs=s8, rhs=s8，WS，per-tensor；矩阵固定顺序编码(s8 展平序号/s16 行列编码)，bias 用 NumPy [-10000,10000) 伪随机；默认 AXI 延迟不随机；预置 SV/Python seed=72000，regr_seed 可统一覆盖（固定激励不会因换种子变随机）
soc_tail_is_int16 # 验证 IS int16 非整 tile 尺寸的尾部处理；Python 生成 case/golden，CPU runtime 固件读 runtime_data.mem 配置 NPU，检查输出与 golden；UVM 检查 finish/status/trap/超时；固定 K/N/M=17/31/19，lhs=s16, rhs=s8，IS，per-tensor；矩阵固定顺序编码(s8 展平序号/s16 行列编码)，bias 用 NumPy [-10000,10000) 伪随机；默认 AXI 延迟不随机；预置 SV/Python seed=72001，regr_seed 可统一覆盖（固定激励不会因换种子变随机）
soc_tail_per_channel_int16 # 验证 WS int16 尾块与 per-channel 量化组合；Python 生成 case/golden，CPU runtime 固件读 runtime_data.mem 配置 NPU，检查输出与 golden；UVM 检查 finish/status/trap/超时；固定 K/N/M=33/17/23，lhs=s16, rhs=s8，WS，per-channel；矩阵固定顺序编码(s8 展平序号/s16 行列编码)，bias 用 NumPy [-10000,10000) 伪随机；默认 AXI 延迟不随机；预置 SV/Python seed=72002，regr_seed 可统一覆盖（固定激励不会因换种子变随机）
soc_fifo_wrap_tail2_ws_int8 # 验证 FIFO 环回及两元素尾部的组合边界；Python 生成 case/golden，CPU runtime 固件读 runtime_data.mem 配置 NPU，检查输出与 golden；UVM 检查 finish/status/trap/超时；固定 K/N/M=272/16/18，lhs=s8, rhs=s8，WS，per-tensor；矩阵固定顺序编码(s8 展平序号/s16 行列编码)，bias 用 NumPy [-10000,10000) 伪随机；配置 W_REUSE_NUM=4；默认 AXI 延迟不随机；预置 SV/Python seed=72014，regr_seed 可统一覆盖（固定激励不会因换种子变随机）
soc_unaligned_randlat_ws_int8 # 验证 WS 非对齐布局与 AXI 随机延迟组合；Python 生成 case/golden，CPU runtime 固件读 runtime_data.mem 配置 NPU，检查输出与 golden；UVM 检查 finish/status/trap/超时；固定 K/N/M=24/32/16，lhs=s8, rhs=s8，WS，per-tensor；矩阵固定顺序编码(s8 展平序号/s16 行列编码)，bias 用 NumPy [-10000,10000) 伪随机；配置 UNALIGNED_LAYOUT=1；DDR_RAND_LAT=1，用仿真 seed 控制延迟：+DDR_RAND_LAT=1 +DDR_CMD_MAX_LAT=3 +DDR_W_MAX_LAT=2 +DDR_RSP_MAX_LAT=8；预置 SV/Python seed=72003，regr_seed 可统一覆盖（固定激励不会因换种子变随机）
soc_runtime_per_channel_ws_int16 # 验证 WS int16 输入的 per-channel 量化；Python 生成 case/golden，CPU runtime 固件读 runtime_data.mem 配置 NPU，检查输出与 golden；UVM 检查 finish/status/trap/超时；固定 K/N/M=16/16/16，lhs=s16, rhs=s8，WS，per-channel；矩阵固定顺序编码(s8 展平序号/s16 行列编码)，bias 用 NumPy [-10000,10000) 伪随机；默认 AXI 延迟不随机；预置 SV/Python seed=72004，regr_seed 可统一覆盖（固定激励不会因换种子变随机）
soc_runtime_per_channel_is_int8 # 验证 IS int8 输入的 per-channel 量化；Python 生成 case/golden，CPU runtime 固件读 runtime_data.mem 配置 NPU，检查输出与 golden；UVM 检查 finish/status/trap/超时；固定 K/N/M=16/16/16，lhs=s8, rhs=s8，IS，per-channel；矩阵固定顺序编码(s8 展平序号/s16 行列编码)，bias 用 NumPy [-10000,10000) 伪随机；默认 AXI 延迟不随机；预置 SV/Python seed=72005，regr_seed 可统一覆盖（固定激励不会因换种子变随机）
soc_min_tile_ws_int8 # 验证 WS 最小尺寸和不足一个 tile 的边界；Python 生成 case/golden，CPU runtime 固件读 runtime_data.mem 配置 NPU，检查输出与 golden；UVM 检查 finish/status/trap/超时；固定 K/N/M=1/1/1，lhs=s8, rhs=s8，WS，per-tensor；矩阵固定顺序编码(s8 展平序号/s16 行列编码)，bias 用 NumPy [-10000,10000) 伪随机；默认 AXI 延迟不随机；预置 SV/Python seed=72006，regr_seed 可统一覆盖（固定激励不会因换种子变随机）
soc_offset_activation_ws_int8 # 验证 WS 非零 lhs/rhs/dst offset 和收窄激活范围；Python 生成 case/golden，CPU runtime 固件读 runtime_data.mem 配置 NPU，检查输出与 golden；UVM 检查 finish/status/trap/超时；固定 K/N/M=16/32/32，lhs=s8, rhs=s8，WS，per-tensor；NumPy 随机 lhs(s8 [-128,128)/s16 [-32768,32768))、rhs s8 [-128,128)、bias [-10000,10000)；配置 LHS_OFFSET=-17, RHS_OFFSET=13, DST_OFFSET=-5, ACT_MIN=-32, ACT_MAX=63；默认 AXI 延迟不随机；预置 SV/Python seed=72007，regr_seed 可统一覆盖（固定激励不会因换种子变随机）
soc_randlat_is_int8 # 验证 IS int8 在 AXI 随机延迟下仍可正确完成；Python 生成 case/golden，CPU runtime 固件读 runtime_data.mem 配置 NPU，检查输出与 golden；UVM 检查 finish/status/trap/超时；固定 K/N/M=19/17/31，lhs=s8, rhs=s8，IS，per-channel；矩阵固定顺序编码(s8 展平序号/s16 行列编码)，bias 用 NumPy [-10000,10000) 伪随机；DDR_RAND_LAT=1，用仿真 seed 控制延迟：+DDR_RAND_LAT=1 +DDR_CMD_MAX_LAT=5 +DDR_W_MAX_LAT=3 +DDR_RSP_MAX_LAT=10；预置 SV/Python seed=72009，regr_seed 可统一覆盖（固定激励不会因换种子变随机）
soc_min_tile_is_int16 # 验证 IS int16 最小尺寸与尾块；Python 生成 case/golden，CPU runtime 固件读 runtime_data.mem 配置 NPU，检查输出与 golden；UVM 检查 finish/status/trap/超时；固定 K/N/M=1/1/1，lhs=s16, rhs=s8，IS，per-tensor；矩阵固定顺序编码(s8 展平序号/s16 行列编码)，bias 用 NumPy [-10000,10000) 伪随机；默认 AXI 延迟不随机；预置 SV/Python seed=72010，regr_seed 可统一覆盖（固定激励不会因换种子变随机）
